# MedSlot environment variables. Copy to `.env` and fill in real values.
#
# Required at runtime on production (Vercel):
#   DATABASE_URL, AUTH_SECRET, CANCEL_TOKEN_SECRET, NEXT_PUBLIC_APP_URL
# Required for migrations / seeding (run once from a trusted machine or CI):
#   DIRECT_URL, plus ADMIN_* and CLINIC_*/DOCTOR_* if you run `pnpm db:seed`
# Required only when EMAIL_PROVIDER=smtp:
#   EMAIL_FROM, SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD
# Everything else is optional and has a safe default.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=MedSlot
DEFAULT_LOCALE=pl
SUPPORTED_LOCALES=pl,en

# Database
# DATABASE_URL is the connection used at runtime. On serverless hosts (Vercel)
# it MUST be a pooled connection. On Neon, copy the "Pooled connection" string
# (its host contains "-pooler"); for the EU region pick Frankfurt for GDPR/RODO.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# DIRECT_URL is a direct (unpooled) connection used only by Prisma migrations and
# introspection. On Neon, use the plain "Direct connection" string (no -pooler).
# For local single-Postgres dev, set this to the SAME value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Auth
AUTH_SECRET="replace-with-secure-random-string"
AUTH_TRUST_HOST=true

# Admin (dev seed) — used by `pnpm db:seed` to create the first admin user.
# DEVELOPMENT DEFAULTS ONLY. Change these (and AUTH_SECRET) before any shared
# or production deployment.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="medslot-admin"

# Clinic / doctor (seed) — used by `pnpm db:seed` to create the clinic and the
# single doctor. Defaults are demo values; set real values before seeding a
# production database. The seed is idempotent (keyed by CLINIC_SLUG and
# DOCTOR_EMAIL), so re-running it will not create duplicates.
CLINIC_NAME="MedSlot Demo Clinic"
CLINIC_SLUG="demo-clinic"
CLINIC_TIMEZONE="Europe/Warsaw"
# Public contact details shown on the landing page. All optional: leave a value
# empty to hide that row on the site. Re-running the seed refreshes them.
CLINIC_PHONE=""
CLINIC_EMAIL=""
CLINIC_ADDRESS=""
DOCTOR_DISPLAY_NAME="Dr. Anna Kowalska"
DOCTOR_EMAIL="doctor@example.com"
# DOCTOR_TIMEZONE is optional; defaults to CLINIC_TIMEZONE when unset.
DOCTOR_TIMEZONE="Europe/Warsaw"

# Email
# Provider switch:
#   log    (default) — sends nothing, just logs. Safe for local dev / trials.
#   smtp   — send via any SMTP server (e.g. Gmail) using nodemailer.
#   resend — reserved for later; requires a verified sending domain.
EMAIL_PROVIDER=log

# Sender shown to recipients. For Gmail SMTP this MUST be your Gmail address.
EMAIL_FROM="MedSlot <your-address@gmail.com>"

# SMTP settings (only required when EMAIL_PROVIDER=smtp).
# Gmail: host smtp.gmail.com, port 465, user = your full Gmail address, and a
# Google "App Password" (16 chars, NO spaces) — requires 2-Step Verification.
# Never commit real credentials; set these in your host env (e.g. Vercel).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-address@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"

# Optional: notify the doctor of new bookings (feature wired in a later step).
DOCTOR_NOTIFICATION_EMAIL="doctor@example.com"

# Resend (reserved for later, when you own a verified domain):
# EMAIL_PROVIDER=resend
# RESEND_API_KEY="replace-with-real-api-key"

# Security
CANCEL_TOKEN_SECRET="replace-with-secure-random-string"

# Data retention (GDPR/RODO) — months of inactivity after a patient's most
# recent appointment before the `pnpm retention:sweep` job may anonymize their
# contact data. Patients with any future appointment are always excluded.
# Optional; defaults to 24 when unset.
RETENTION_MONTHS=24

# Sentry optional
SENTRY_DSN=""

